# Configure on the server only. Never commit .env, databases, avatars or backups.
DATABASE_URL="file:../data/cinema.db"
DATA_DIR="./data"
# OAuth requires an HTTPS test origin. HTTP previews show setup/login only.
APP_URL="https://scene.example.com"
DEFAULT_TIMEZONE="Asia/Shanghai"
TRAKT_ALLOWED_USERNAME="your-trakt-username"
# Optional initial UUID restriction; after first authorization the stored UUID is always checked.
TRAKT_ALLOWED_USER_ID=""
TRAKT_CLIENT_ID=""
# PKCE does not require a Client Secret. No Trakt passwords are collected.
# 32 random bytes encoded as 64 hex characters; generate locally, preserve securely.
TOKEN_ENCRYPTION_KEY=""
# Optional server-side TMDB API Read Access Token.
TMDB_READ_ACCESS_TOKEN=""
# Disable scheduled sync only for maintenance or isolated tests.
DISABLE_BACKGROUND_WORKER="false"
